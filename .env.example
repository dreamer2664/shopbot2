# Copy to .env and fill in. NEVER commit .env.
# LIVE mode requires BOTH Printify AND Shopify credentials — anything less
# stays in dry run (mock providers, zero network) by design.

# --- Core supplier (Print-on-demand) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# --- Storefront: Shopify ---
SHOPIFY_STORE_DOMAIN=mystore.myshopify.com
SHOPIFY_ADMIN_TOKEN=
# Webhook signing secret from the Shopify webhook settings (HMAC verification)
SHOPIFY_WEBHOOK_SECRET=

# --- Social posting (self-hosted Postiz = free; it holds the Meta/TikTok approvals) ---
POSTIZ_URL=
POSTIZ_API_KEY=
# Comma-separated integration ids from Postiz UI (one per connected account)
POSTIZ_INTEGRATION_IDS=

# --- Owner notifications (Telegram: free, instant via @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Customer email (Resend: 100/day free, needs verified domain) ---
RESEND_API_KEY=
EMAIL_FROM=orders@yourdomain.com
