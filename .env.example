# Copy to .env and fill in. NEVER commit .env.

# --- Core supplier (Print-on-demand) ---
PRINTIFY_API_TOKEN=

# --- Storefront (pick one) ---
# WooCommerce (free, self-hosted)
WC_STORE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# Shopify (~1 EUR/mo promo, then ~36 EUR/mo)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# --- Social posting (Postiz self-hosted = free, holds Meta/TikTok approvals) ---
POSTIZ_URL=
POSTIZ_API_KEY=

# --- Owner notifications (free, no approval needed) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Transactional email (Resend: 100/day free) ---
RESEND_API_KEY=
EMAIL_FROM=orders@yourdomain.com
